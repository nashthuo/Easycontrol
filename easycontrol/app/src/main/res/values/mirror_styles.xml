<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="MirrorKeyButton">
    <item name="android:layout_width">40dp</item>
    <item name="android:layout_height">40dp</item>
    <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    <item name="android:padding">9dp</item>
    <item name="android:scaleType">fitCenter</item>
    <item name="android:tint">@color/onCardBackground</item>
  </style>
  <style name="MirrorCloseButton">
    <item name="android:layout_width">36dp</item>
    <item name="android:layout_height">36dp</item>
    <item name="android:background">@drawable/background_cron</item>
    <item name="android:backgroundTint">@color/cardBackground</item>
    <item name="android:contentDescription">@string/mirror_close</item>
    <item name="android:padding">8dp</item>
    <item name="android:scaleType">fitCenter</item>
    <item name="android:src">@drawable/close</item>
    <item name="android:tint">@color/buttonSecond</item>
  </style>
  <style name="MirrorDockButton">
    <item name="android:layout_width">36dp</item>
    <item name="android:layout_height">36dp</item>
    <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    <item name="android:padding">8dp</item>
    <item name="android:scaleType">fitCenter</item>
    <item name="android:tint">@color/onCardBackground</item>
  </style>
</resources>
