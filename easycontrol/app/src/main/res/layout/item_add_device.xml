<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/background_cron"
  android:backgroundTint="@color/cardBackground"
  android:orientation="vertical"
  android:paddingStart="20dp"
  android:paddingTop="20dp"
  android:paddingEnd="20dp"
  android:paddingBottom="20dp">

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/device_name"
    android:textColor="@color/onCardBackground"
    android:textSize="@dimen/largeFont" />

  <EditText
    android:id="@+id/name"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:hint="@string/device_name_hint"
    android:textColor="@color/onCardBackground"
    android:textColorHint="@color/onCardBackgroundSecond"
    android:textSize="@dimen/middleFont" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/device_address_with_port"
    android:textColor="@color/onCardBackground"
    android:textSize="@dimen/largeFont" />

  <EditText
    android:id="@+id/address"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:digits="0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ[].:-_%"
    android:hint="@string/device_address_with_port_hint"
    android:textColor="@color/onCardBackground"
    android:textColorHint="@color/onCardBackgroundSecond"
    android:textSize="@dimen/middleFont" />

  <Button
    android:id="@+id/scan_network"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/scan_network" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:labelFor="@id/fallback_address"
    android:text="@string/device_fallback_address"
    android:textColor="@color/onCardBackground"
    android:textSize="@dimen/largeFont" />

  <EditText
    android:id="@+id/fallback_address"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:digits="0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ[].:-_%"
    android:hint="@string/device_address_with_port_hint"
    android:textColor="@color/onCardBackground"
    android:textColorHint="@color/onCardBackgroundSecond"
    android:textSize="@dimen/middleFont" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <CheckBox
      android:id="@+id/is_audio"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:buttonTint="@color/onCardBackground"
      android:text="@string/device_is_audio"
      android:textColor="@color/onCardBackgroundSecond"
      android:textSize="@dimen/middleFont" />

    <CheckBox
      android:id="@+id/is_options"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_marginTop="8dp"
      android:buttonTint="@color/onCardBackground"
      android:text="@string/device_advanced"
      android:textColor="@color/onCardBackgroundSecond"
      android:textSize="@dimen/middleFont" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/options"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:visibility="gone" />

  <Button
    android:id="@+id/ok"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="50dp"
    android:layout_marginTop="25dp"
    android:layout_marginEnd="50dp"
    android:background="@drawable/background_cron"
    android:backgroundTint="@color/button"
    android:gravity="center"
    android:padding="6dp"
    android:text="@string/device_button"
    android:textColor="@color/onButton"
    android:textSize="@dimen/largeFont" />

</LinearLayout>