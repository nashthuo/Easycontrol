<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:background="@drawable/background_cron"
  android:backgroundTint="@color/cardContainerBackground"
  android:minWidth="136dp">

  <FrameLayout
    android:id="@+id/texture_view_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="5dp"
    android:layout_marginTop="15dp"
    android:layout_marginRight="5dp"
    android:layout_marginBottom="5dp"
    android:background="#000">


    <ImageView
      android:layout_width="@dimen/round"
      android:layout_height="@dimen/round"
      android:layout_gravity="start|top"
      android:src="@drawable/round"
      android:tint="@color/cardContainerBackground" />

    <ImageView
      android:layout_width="@dimen/round"
      android:layout_height="@dimen/round"
      android:layout_gravity="end|top"
      android:rotation="90"
      android:src="@drawable/round"
      android:tint="@color/cardContainerBackground" />

    <ImageView
      android:layout_width="@dimen/round"
      android:layout_height="@dimen/round"
      android:layout_gravity="start|bottom"
      android:rotation="-90"
      android:src="@drawable/round"
      android:tint="@color/cardContainerBackground" />

    <ImageView
      android:layout_width="@dimen/round"
      android:layout_height="@dimen/round"
      android:layout_gravity="end|bottom"
      android:rotation="180"
      android:src="@drawable/round"
      android:tint="@color/cardContainerBackground" />

  </FrameLayout>

  <View
    android:id="@+id/re_size"
    android:layout_width="30dp"
    android:layout_height="30dp"
    android:layout_gravity="end|bottom" />

  <ImageView
    android:id="@+id/bar"
    android:layout_width="60dp"
    android:layout_height="15dp"
    android:layout_gravity="center_horizontal|top"
    android:contentDescription="@string/mirror_controls"
    android:src="@drawable/bar"
    android:tint="@color/clientBar" />

  <GridLayout
    android:id="@+id/bar_view"
    android:layout_width="176dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="40dp"
    android:background="@drawable/background_cron"
    android:backgroundTint="@color/cardBackground"
    android:columnCount="3"
    android:padding="8dp"
    android:visibility="gone">

    <ImageView
      android:id="@+id/button_mini"
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:layout_columnWeight="1"
      android:contentDescription="@string/mirror_minimize"
      android:src="@drawable/mini"
      android:tint="@color/onCardBackground" />

    <ImageView
      android:id="@+id/button_full"
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:layout_columnWeight="1"
      android:contentDescription="@string/mirror_fullscreen"
      android:src="@drawable/fullscreen"
      android:tint="@color/onCardBackground" />

    <ImageView
      android:id="@+id/button_display"
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:layout_columnWeight="1"
      android:contentDescription="@string/mirror_display"
      android:src="@drawable/power"
      android:tint="@color/onCardBackground" />

    <Space
      android:layout_height="8dp"
      android:layout_columnSpan="3" />

    <ImageView
      android:id="@+id/button_switch"
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:layout_columnWeight="1"
      android:contentDescription="@string/mirror_recent_apps"
      android:src="@drawable/menu"
      android:tint="@color/onCardBackground" />

    <ImageView
      android:id="@+id/button_home"
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:layout_columnWeight="1"
      android:contentDescription="@string/mirror_home"
      android:src="@drawable/home"
      android:tint="@color/onCardBackground" />

    <ImageView
      android:id="@+id/button_back"
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:layout_columnWeight="1"
      android:contentDescription="@string/mirror_back"
      android:src="@drawable/back"
      android:tint="@color/onCardBackground" />

    <Space
      android:layout_height="8dp"
      android:layout_columnSpan="3" />

    <include
      android:id="@+id/key_controls"
      layout="@layout/mirror_key_buttons"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_columnSpan="3" />

  </GridLayout>

  <LinearLayout
    android:id="@+id/reconnect_status"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:accessibilityLiveRegion="polite"
    android:background="@drawable/background_cron"
    android:backgroundTint="@color/cardContainerBackground"
    android:contentDescription="@string/mirror_reconnect_action"
    android:gravity="center"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
      android:id="@+id/reconnect_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/mirror_reconnecting"
      android:textColor="@color/onCardContainerBackground"
      android:textSize="16sp" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="@string/mirror_cancel_reconnect"
      android:textColor="@color/onCardContainerBackground"
      android:textSize="13sp" />
  </LinearLayout>

  <ImageButton
    android:id="@+id/button_close"
    style="@style/MirrorCloseButton"
    android:layout_gravity="top|end"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="2dp" />
</FrameLayout>
